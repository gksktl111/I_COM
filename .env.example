# Server only. Use the approved public-data portal key; never commit actual values.
GOV24_API_KEY=

# Server-side DB ingestion credentials; MCP authentication does not populate these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local migration/admin tooling only; never needed by the deployed collector.
SUPABASE_ACCESS_TOKEN=

# Set true for manual DB writes only after confirming the development target and migration.
POLICY_SYNC_ENABLED=
# Reserved for a future scheduled endpoint; not used by the current CLI.
POLICY_SYNC_CRON_SECRET=

# Planned Bokjiro probes: separate API approval is required. Not consumed by current CLI.
BOKJIRO_CENTRAL_API_KEY=
BOKJIRO_LOCAL_API_KEY=
