# 실제 값은 .env.local에만 입력하고 Git에 커밋하지 않습니다.
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 공개됩니다.

# ── 지도·위치 검색 ──
# 네이버 지도 표시용 공개 키 ID: 브라우저에서 사용
NEXT_PUBLIC_NCP_KEY_ID=
# 네이버 좌표→주소 변환용 키 ID: 서버 전용
NCP_API_KEY_ID=
# 네이버 좌표→주소 변환용 비밀 키: 서버 전용
NCP_API_KEY=
# 카카오 장소 검색용 REST API 키: 서버 전용
KAKAO_REST_API_KEY=

# ── 정책 데이터 API ──
# 정부24 정책 목록·상세·지원조건 조회: 활용 승인된 공공데이터포털 키
GOV24_API_KEY=
# 복지로 중앙부처 정책 조회용: 해당 API 활용 승인된 인증키
BOKJIRO_CENTRAL_API_KEY=
# 복지로 지자체 정책 조회용: 해당 API 활용 승인된 인증키
BOKJIRO_LOCAL_API_KEY=

# ── Supabase 데이터 저장 ──
# 정책 데이터를 저장할 Supabase 프로젝트 URL
SUPABASE_URL=
# 데이터 API 접근용 서버 비밀 키: 브라우저에 노출 금지
SUPABASE_SECRET_KEY=

# ── 정책 수집 실행 설정 ──
# 개발 DB와 마이그레이션 확인 후 수동 저장 시 true 설정; 빈 값은 저장 비활성화
POLICY_SYNC_ENABLED=
# 향후 예약 실행 요청 인증용 비밀값: 현재 CLI에서는 사용하지 않음
POLICY_SYNC_CRON_SECRET=

# ── 로컬 개발·관리 도구 ──
# Supabase 관리 API·마이그레이션용 개인 액세스 토큰: 배포 수집기에는 불필요
SUPABASE_ACCESS_TOKEN=
# Stitch 디자인 조회·연결용 API 키: 서비스 실행에는 불필요
STITCH_API_KEY=
